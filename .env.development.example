# Cópia para `.env.development` (não commitar — está no .gitignore).
# Usado automaticamente em `npm run dev` (modo development do Vite).
# Valores = consola Firebase → Definições do projeto → As tuas apps → app Web (projeto DEV).
# Importante: VITE_FIREBASE_* tem de ser o MESMO projecto onde gravaste `siteCopy` / `publicContent` no
# admin. Se forem diferentes, a home lê vazio (só o modo dev com cópia local preenche o texto).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: WhatsApp só com dígitos (indicativo do país), ex. 351912345678 — usado em wa.me e no formulário.
# VITE_WHATSAPP_PHONE=
