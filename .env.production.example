# Cópia opcional para `.env.production` ou `.env.production.local` (não commitar).
# Usado em `npm run build` / `npm run preview` (modo production do Vite).
#
# Em equipas, o normal é NÃO ter chaves de prod na máquina: produção só na CI (secrets GitHub).
# Usa este ficheiro só se precisares de um build local idêntico ao de prod.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: WhatsApp (só dígitos, com indicativo), ex. 351912345678
# VITE_WHATSAPP_PHONE=
