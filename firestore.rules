rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && userDocExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /siteCopy/{docId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /caseStudies/{caseStudyId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /siteVisits/{visitId} {
      function validGeoData() {
        return request.resource.data.geo == null
          || (
            request.resource.data.geo is map
            && request.resource.data.geo.keys().hasOnly([
              'city',
              'region',
              'country',
              'countryCode',
              'latitude',
              'longitude'
            ])
            && (request.resource.data.geo.city == null || request.resource.data.geo.city is string)
            && (request.resource.data.geo.region == null || request.resource.data.geo.region is string)
            && (request.resource.data.geo.country == null || request.resource.data.geo.country is string)
            && (request.resource.data.geo.countryCode == null || request.resource.data.geo.countryCode is string)
            && request.resource.data.geo.latitude is number
            && request.resource.data.geo.longitude is number
          );
      }

      allow create, update: if request.resource.data.keys().hasOnly([
          'path',
          'createdAt',
          'dayKey',
          'visitorId',
          'geo'
        ])
        && request.resource.data.path is string
        && request.resource.data.path.size() >= 1
        && request.resource.data.path.size() <= 400
        && request.resource.data.dayKey is string
        && request.resource.data.dayKey.size() >= 8
        && request.resource.data.dayKey.size() <= 20
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 8
        && request.resource.data.visitorId.size() <= 120
        && request.resource.data.createdAt == request.time
        && validGeoData();
      allow read: if isAdmin();
      allow delete: if false;
    }

    match /contactRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name',
        'email',
        'whatsapp',
        'company',
        'needType',
        'needLabel',
        'message',
        'privacyAccepted',
        'origin',
        'productId',
        'productTitle',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.status == 'new'
      && request.resource.data.privacyAccepted == true
      && request.resource.data.name is string
      && request.resource.data.email is string
      && request.resource.data.whatsapp is string
      && request.resource.data.message is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
