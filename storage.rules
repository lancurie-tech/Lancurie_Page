rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /siteCopy/images/{imageKey} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteCopy/home-products/{productKey} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
